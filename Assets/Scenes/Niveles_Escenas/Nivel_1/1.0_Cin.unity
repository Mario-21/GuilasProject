    - target: {fileID: 6015140190268276383, guid: 89befcfdc18d3f741a7bf90276308dc7,
        type: 3}
      propertyPath: notasRecodatorio.Array.data[0]
      value: "En la segunda cinem\xE1tica no se recargara ninguna escena. Esto es
        m\xE1s que nada para evitar lios con los cambios de c\xE1mara a la hora de
        cambiar de escena.\nAl iniciar se aplicara el trigger de optimizar solo para
        la primera cin. de la petrol. Mientras que la playa permanecera siempre oculta,
        hasta el momento que requieras de ella, por medio del script de la cin. Consecuentemente
        tambi\xE9n haces desaparecer la caba\xF1a"
      objectReference: {fileID: 0}
    m_RemovedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 89befcfdc18d3f741a7bf90276308dc7, type: 3}
