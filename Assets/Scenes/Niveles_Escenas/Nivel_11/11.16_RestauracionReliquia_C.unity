        type: 3}
      propertyPath: m_LocalEulerAnglesHint.x
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6015140190268276381, guid: 89befcfdc18d3f741a7bf90276308dc7,
        type: 3}
      propertyPath: m_LocalEulerAnglesHint.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6015140190268276381, guid: 89befcfdc18d3f741a7bf90276308dc7,
        type: 3}
      propertyPath: m_LocalEulerAnglesHint.z
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6015140190268276383, guid: 89befcfdc18d3f741a7bf90276308dc7,
        type: 3}
      propertyPath: notasRecodatorio.Array.data[0]
      value: "Este puerta hay que cambiarla, cuando esten en horario de trabajo,
        se escuchara una manguera o pistola a presion de agua, mostrando as\xED que
        estan trabajando.\nLa idea actual de esto es que la zona izquierda no funciona
        o esta inhabilitada para limpiar, por falta de materiales o algo as\xED.
        Lo suyo es adentrarse en esta habitacion para limpiar la reliquia, esto se
        conseguira petando el tanque.\nTras petar el tanque estos dos se quedaran
        fuera en las mesas de la zona anterior y habr\xE1n dejado la puerta abierta.\n\nPuntos
        a tener en cuenta:\n\n- \xBFQu\xE9 ocurre si me cargo los enemigos antes
        de que ocurra el evento del Tanque?\nLa puerta quedar\xF1a permanentemente
        cerrada.\n-\n\nSONIDO DE UNA MANGUERA\nCOLOCAR SONIDO DE USAR LA MANGUERA
        EN LA RELIQUIA LIMPIAR"
      objectReference: {fileID: 0}
    m_RemovedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 89befcfdc18d3f741a7bf90276308dc7, type: 3}
