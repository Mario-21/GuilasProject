      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6015140190268276383, guid: 89befcfdc18d3f741a7bf90276308dc7,
        type: 3}
      propertyPath: notasRecodatorio.Array.data[0]
      value: "Estos dos solo buscan el tag del Player por tanto solo ye buscaran
        cuando despliegues el arma.\nLa cosa de estos dos que es que tienen el detectar_echar,
        lo que simula que cuando te acerques a ellos te pillen, a no ser que te coloques
        el casco minero y simules ir a trabajar.\nEsto en principio si te acercaras
        normal tampoco te detectar\xEDan, lo que genera que al llevar el casco y
        desactivar los trigger da la sensacion de que realmente te has camuflado,
        sin necesidad de cambiar a los dem\xE1s enemigos.\nSeguir haciendo pruebas
        en los dem\xE1s niveles\n\n\n"
      objectReference: {fileID: 0}
    m_RemovedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 89befcfdc18d3f741a7bf90276308dc7, type: 3}
