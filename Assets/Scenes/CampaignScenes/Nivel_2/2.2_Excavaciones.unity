        type: 3}
      propertyPath: notasRecodatorio.Array.data[0]
      value: "Reestructurar un poco la munici\xF3n que consigues. Si yo consigo +3
        de munci\xF3n inicialmente y lo comparo\ncon todo el proceso que tengo que
        ejecutar el derrumbamiento solo conseguiria un +2 de munici\xF3n.\nMe sigue
        rentando NO hacer el derrumbamiento.\nEsto se puede solucionar colocando
        +1 de munici\xF3n adicional y haciendo que el personaje que guarda la munici\xF3n
        de +3 permanezca est\xE1tico, perfecto para disparar a la viga y le caiga
        encima, haciendo que solo sea posible de esa manera para pillar la munici\xF3n.
        Transformando la situaci\xF3n en +2/+3"
      objectReference: {fileID: 0}
    m_RemovedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 89befcfdc18d3f741a7bf90276308dc7, type: 3}
