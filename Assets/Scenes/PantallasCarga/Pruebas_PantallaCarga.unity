  - 813dd696_InteractText
  - 5903bd8d_LaundryText
  - 88d76b9a_AmmoText
  - 2b277354_ItemsText
  - dcb453a3_EquipmentText
  - d9bb06ff_ObjectivesText
  - cb9ceda0_Soldiers1Text
  - fc0b3c12_EnviromentText
  - c4d20032_CraftText
